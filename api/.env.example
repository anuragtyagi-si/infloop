# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/infloop
# "true" connects over TLS and verifies the server certificate; "no-verify" skips
# verification (only for hosts that present a self-signed certificate)
DATABASE_SSL=false
# Signing key for login tokens: at least 32 random characters
JWT_SECRET=
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=https://anuragtyagi-si.github.io,http://localhost:5173
# Number of reverse proxies in front of the API (1 on Render); leave 0 when clients connect directly
TRUST_PROXY=0
PORT=4000
